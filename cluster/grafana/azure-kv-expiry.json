                      "kind": "DataQuery",
                      "group": "grafana-azure-monitor-datasource",
                      "version": "v0",
                      "spec": {
                        "azureResourceGraph": {
                          "query": "PolicyResources\n| where type =~ \"microsoft.policyinsights/componentpolicystates\"\n| extend ComplianceState = tostring(properties.complianceState), ObjectName = tostring(properties.componentId), PolicyDefinitionId = tostring(properties.policyDefinitionId), ResourceId = tostring(properties.resourceId)\n| where ComplianceState =~ \"NonCompliant\"\n| where PolicyDefinitionId endswith \"b0eb591a-5e70-4534-a8bf-04b9c489584a\" or PolicyDefinitionId endswith \"5ff38825-c5d8-47c5-b70e-069a21955146\" or PolicyDefinitionId endswith \"f772fb64-8e40-40ad-87bc-7706e1949427\"\n| extend ObjectType = case(PolicyDefinitionId endswith \"b0eb591a-5e70-4534-a8bf-04b9c489584a\", \"Secret\", PolicyDefinitionId endswith \"5ff38825-c5d8-47c5-b70e-069a21955146\", \"Key\", PolicyDefinitionId endswith \"f772fb64-8e40-40ad-87bc-7706e1949427\", \"Certificate\", \"Unknown\")\n| summarize by subscriptionId, ResourceId, ObjectName, ObjectType\n| summarize NonCompliantObjects = count()",
