{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "flux": {
    "managerFilePatterns": ["/(^|/)cluster/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)cluster/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["flux", "kubernetes"],
      "labels": ["dependencies", "kubernetes"]
    },
    {
      "matchFileNames": ["cluster/apps/garmin-grafana/influxdb-deployment.yaml"],
      "matchPackageNames": ["influxdb"],
      "enabled": false
    },
    {
      "matchPackageNames": ["*"],
      "groupName": "all dependency updates",
      "groupSlug": "all-dependency-updates"
    }
  ]
}
